{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/predict.py": {
      "maxDuration": 60,
      "includeFiles": "models/**",
      "excludeFiles": "{tests/**,src/**,public/**,dist/**,node_modules/**,dev_server.py,README.md}"
    }
  }
}
